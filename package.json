{
  "name": "audio-joiner",
  "productName": "Audio Join",
  "version": "1.2.0",
  "description": "Join, convert and record audio files. Mix WAV, MP3, M4A, FLAC and OGG.",
  "main": "main.js",
  "author": "Audio Joiner",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.audiojoiner.app",
    "productName": "Audio Join",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "merge.js",
      "index.html",
      "package.json",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "appx": {
      "identityName": "BenAri.AudioJoin",
      "publisher": "CN=F71D5B9C-CFAD-403C-946E-6992D1322615",
      "publisherDisplayName": "Ben Ari",
      "applicationId": "AudioJoin",
      "displayName": "Audio Join",
      "backgroundColor": "#3b4fe0",
      "languages": [
        "en-US"
      ]
    }
  }
}